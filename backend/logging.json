{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {"format": "%(asctime)s %(levelname)s %(name)s: %(message)s"},
    "access": {"()": "uvicorn.logging.AccessFormatter", "format": "%(asctime)s %(client_addr)s %(request_line)s %(status_code)s", "use_colors": false}
  },
  "handlers": {
    "default": {"class": "logging.StreamHandler", "stream": "ext://sys.stdout", "formatter": "default"},
    "access": {"class": "logging.StreamHandler", "stream": "ext://sys.stdout", "formatter": "access"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "uvicorn.access": {"handlers": ["access"], "level": "INFO", "propagate": false},
    "tutor.ai": {"handlers": ["default"], "level": "INFO", "propagate": false}
  }
}
